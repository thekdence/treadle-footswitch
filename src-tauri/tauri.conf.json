{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treadle",
  "version": "0.1.0",
  "identifier": "dev.treadle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Treadle",
        "width": 780,
        "height": 700,
        "minWidth": 520,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Configure PCsensor USB foot switches",
    "category": "Utility"
  }
}
